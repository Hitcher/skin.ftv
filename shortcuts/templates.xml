	<propertyGroups>
		<propertyGroup name="widget-style">
			<!-- Wide episodes use thumbs; TV shows retain fTV art/fanart/logo selection. -->
			<var name="styleLabel">
				<value condition="widgetType=episodes + !widgetStyle">$LOCALIZE[31159]</value>
				<value condition="widgetStyle=wide">$LOCALIZE[31159]</value>
				<value condition="widgetStyle=poster">$LOCALIZE[31160]</value>
				<value condition="widgetStyle=square">$LOCALIZE[31203]</value>
				<value condition="widgetStyle=squareinfo">$LOCALIZE[31161]</value>
			</var>
			<var name="wideArtFTV1">
				<value condition="widgetType=episodes">$INFO[Container($MATH[$PROPERTY[groupId] + $PROPERTY[index]]).ListItemPosition(0).Art(thumb)]</value>
				<value>$INFO[Container($MATH[$PROPERTY[groupId] + $PROPERTY[index]]).ListItemPosition(0).Art(ftv)]</value>
			</var>
			<var name="wideArtFanart1">
				<value condition="widgetType=episodes"></value>
				<value>$INFO[Container($MATH[$PROPERTY[groupId] + $PROPERTY[index]]).ListItemPosition(0).Art(fanart)]</value>
			</var>
			<var name="wideArtLogo1">
				<value condition="widgetType=episodes"></value>
				<value>$INFO[Container($MATH[$PROPERTY[groupId] + $PROPERTY[index]]).ListItemPosition(0).Art(clearlogo)]</value>
			</var>
