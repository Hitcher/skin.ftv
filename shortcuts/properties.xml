	<property name="widgetStyle" type="options">
		<options>
			<option value="wide" label="31159"/>
			<option value="poster" label="31160"/>
			<option value="square" label="31203"/>
			<option value="squareinfo" label="31161"/>
		</options>
	</property>
	<property name="widgetSortBy" type="options">
		<options>
			<option value="none" label="571"/>
			<option value="label" label="label"/>
			<option value="name" label="name"/>
			<option value="dateadded" label="dateadded"/>
			<option value="lastplayed" label="lastplayed"/>
			<option value="playcount" label="playcount"/>
			<option value="year" label="year"/>
			<option value="rating" label="rating"/>
			<option value="userrating" label="userrating"/>
			<option value="votes" label="votes"/>
			<option value="genre" label="genre"/>
			<option value="country" label="country"/>
			<option value="studio" label="studio"/>
			<option value="playlistorder" label="playlistorder"/>
			<option value="episodenumber" label="episodenumber"/>
			<option value="season" label="season"/>
			<option value="numberofepisodes" label="numberofepisodes"/>
			<option value="numberofwatchedepisodes" label="numberofwatchedepisodes"/>
			<option value="tvshowstatus" label="tvshowstatus"/>
			<option value="tvshowtitle" label="tvshowtitle"/>
			<option value="file" label="file"/>
			<option value="title" label="title"/>
